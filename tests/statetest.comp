#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer B { uint data[]; };
layout(push_constant) uniform P { uint tag; uint n; uint mul; uint pad; } pc;
/* Independent-dispatch STATE hazard, deliberately with no data dependency.
   Every dispatch owns its own buffer and its own push constants, so Vulkan
   requires no barrier between any two of them. The only thing that can go
   wrong is the hardware reusing a previous dispatch's descriptor or uniform
   state -- which is what the CDM barrier's USC/uniform bits are believed to
   prevent, and what cstest.c (one binding, bound once) cannot see. */
void main() {
   uint i = gl_GlobalInvocationID.x;
   if (i >= pc.n) return;
   data[i] = pc.tag * pc.mul + i;
}
