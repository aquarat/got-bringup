#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer B { uint data[]; };
layout(push_constant) uniform P { uint tag; uint n; uint mul; uint pad; } pc;
/* Same contract as statetest.comp but a different program, so that alternating
   between the two also changes the shader address the USC must fetch. */
void main() {
   uint i = gl_GlobalInvocationID.x;
   if (i >= pc.n) return;
   uint acc = 0u;
   for (uint k = 0u; k < 3u; k++) acc += pc.tag;
   data[i] = (acc / 3u) * pc.mul + i;
}
