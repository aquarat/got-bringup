#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer B { uint data[]; };
layout(set = 0, binding = 1) uniform U { uvec4 v[96]; } ubo;
layout(push_constant) uniform P { uint n; } pc;
/* 96 loads at invocation-INDEPENDENT offsets, so nir_opt_preamble hoists them
   all into the preamble, which AGX runs on a single thread before the shader
   body. The body itself is trivial.

   Sweep the workgroup count: if the preamble is cheap, or is amortised across
   the dispatch, total time should barely move between 1 and many workgroups.
   If it dominates small dispatches -- the case the cost model assumes away --
   a 1-workgroup dispatch costs almost as much as a 64-workgroup one. */
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint acc = 0u;
    acc += ubo.v[0].x;
    acc += ubo.v[1].x;
    acc += ubo.v[2].x;
    acc += ubo.v[3].x;
    acc += ubo.v[4].x;
