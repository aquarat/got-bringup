#!/bin/bash
# honeykrisp-got -- put the patched Honeykrisp Vulkan driver in front of the
# system one, and take it away again.
#
# WHY A SWAP AND NOT AN EXTRA ICD
# -------------------------------
# The obvious packaging -- drop a second ICD manifest in /usr/share/vulkan/icd.d
# and let the loader find it -- does not reach a Steam game, and the failure is
# silent. Established in got-bringup CHECKLIST.md items 6, 7, 7a and 7b:
#
#   * FEX's ThunksDB overlays libvulkan.so.1 only at fixed, standard paths.
#   * The game loads pressure-vessel's IMPORTED copy of the HOST driver, taken
#     from the host's standard library path.
#   * muvm's --execute-pre hook, which would allow a guest-scoped bind mount,
#     aborts the launch in muvm-0.6.0-3.
#   * PRESSURE_VESSEL_FILESYSTEMS_RO does not help either.
#
# So the file at %LIBDIR%/libvulkan_asahi.so is the one mechanism that actually
# delivers a driver to the game. This package installs its driver beside that
# path and swaps it in on request, keeping the distro file as a backup.
#
# THE RISK, STATED PLAINLY
# ------------------------
# That same file is what KWin and every other desktop Vulkan client uses. If
# the driver is bad, the desktop goes down with it. Recovery needs no GPU:
#
#     Ctrl-Alt-F3, log in, then:  honeykrisp-got disable
#
# The backup is a plain file copy, so that works with no working driver.

set -uo pipefail

PROG=honeykrisp-got
PRIVDIR=%LIBDIR%/honeykrisp-got
OURS="$PRIVDIR/libvulkan_asahi.so"
OUR_ICD="%DATADIR%/honeykrisp-got/asahi_icd.aarch64.json"
DRIRC_SRC="%DATADIR%/honeykrisp-got/drirc-hk-vkd3d.conf"
SYS=%LIBDIR%/libvulkan_asahi.so
BACKUP=%LIBDIR%/libvulkan_asahi.so.honeykrisp-got-backup
STAMPDIR=%LOCALSTATEDIR%/lib/honeykrisp-got
STAMP="$STAMPDIR/enabled"

QUIET=0
ASSUME_YES=0

say()  { [ "$QUIET" = 1 ] || echo "$@"; }
err()  { echo "$PROG: $*" >&2; }
die()  { err "$*"; exit 1; }

need_root() {
    [ "$(id -u)" = 0 ] && return 0
    command -v sudo >/dev/null || die "must run as root"
    exec sudo -- "$0" "$ORIG_ARGV_0" ${ORIG_ARGV_REST:+$ORIG_ARGV_REST}
}

# ---------------------------------------------------------------- sanity check

# Refuse to install a driver that cannot enumerate the GPU. This is the single
# check that separates "slower than hoped" from "no desktop".
driver_enumerates() {
    local so="$1" icd out
    command -v vulkaninfo >/dev/null || {
        err "vulkaninfo is not installed, so the driver cannot be checked before"
        err "it is deployed. Install vulkan-tools, or pass --force."
        return 2
    }
    icd=$(mktemp /tmp/hkgot-icd-XXXXXX.json) || return 2
    printf '{"ICD":{"api_version":"1.4.0","library_arch":"64","library_path":"%s"},"file_format_version":"1.0.1"}\n' \
        "$so" > "$icd"
    out=$(VK_DRIVER_FILES="$icd" vulkaninfo --summary 2>/dev/null)
    rm -f "$icd"
    grep -qi 'Apple M[0-9]' <<<"$out"
}

# ------------------------------------------------------------------ primitives

# Replace $SYS by rename, never by writing over it. /usr/lib64/libvulkan_asahi.so
# is mapped into every running Vulkan client; rewriting those pages under a live
# compositor is how you get a hard freeze instead of a clean swap. rename(2)
# leaves existing mappings pointing at the old inode, so running clients keep the
# driver they started with until they restart.
atomic_install() {
    local src="$1" dst="$2" tmp
    tmp="$dst.hkgot-new.$$"
    install -m 0755 -o root -g root "$src" "$tmp" || return 1
    if command -v restorecon >/dev/null; then restorecon -F "$tmp" 2>/dev/null; fi
    mv -f "$tmp" "$dst"
}

is_ours() { cmp -s "$SYS" "$OURS"; }

# ------------------------------------------------------------------ subcommands

cmd_status() {
    echo "packaged driver : $OURS"
    if [ -f "$OURS" ]; then
        echo "  size          : $(stat -c %s "$OURS") bytes"
    else
        echo "  MISSING -- the package is not installed correctly"
    fi
    echo "system driver   : $SYS"
    echo "  size          : $(stat -c %s "$SYS" 2>/dev/null || echo '-') bytes"
    echo "  mtime         : $(stat -c %y "$SYS" 2>/dev/null || echo '-')"
    if [ ! -f "$SYS" ]; then
        echo "  state         : ABSENT (is mesa-vulkan-drivers installed?)"
    elif is_ours; then
        echo "  state         : HONEYKRISP-GOT DEPLOYED"
    else
        echo "  state         : distro driver"
    fi
    echo "backup          : $([ -f "$BACKUP" ] && stat -c '%s bytes, %y' "$BACKUP" || echo 'none')"
    echo "enable stamp    : $([ -f "$STAMP" ] && cat "$STAMP" || echo 'not set')"
    echo
    echo "user driconf    : $HOME/.drirc $(grep -qs 'driver="hk"' "$HOME/.drirc" && echo '(has hk options)' || echo '(no hk options -- run: '"$PROG"' user-config)')"
    echo
    echo "what the system path reports:"
    if command -v vulkaninfo >/dev/null; then
        vulkaninfo --summary 2>/dev/null |
            grep -E 'deviceName|driverName|driverInfo' | sed 's/^/  /' ||
            echo "  vulkaninfo produced nothing"
    else
        echo "  vulkaninfo not installed"
    fi
}

cmd_test() {
    [ -f "$OURS" ] || die "no packaged driver at $OURS"
    command -v vulkaninfo >/dev/null || die "vulkaninfo is not installed (dnf install vulkan-tools)"
    echo "testing $OURS without touching the system driver:"
    VK_DRIVER_FILES="$OUR_ICD" vulkaninfo --summary 2>/dev/null |
        grep -E 'deviceName|driverName|driverInfo|apiVersion' | sed 's/^/  /'
    echo
    echo "Anything running under Steam will NOT pick this up -- see the comment at"
    echo "the top of $0. For the game you need '$PROG enable'."
}

cmd_enable() {
    need_root
    [ -f "$OURS" ] || die "no packaged driver at $OURS"
    [ -f "$SYS" ]  || die "$SYS does not exist. Install mesa-vulkan-drivers first."

    if [ "${FORCE:-0}" != 1 ]; then
        driver_enumerates "$OURS"
        case $? in
        0) say "  ok, the packaged driver enumerates the GPU" ;;
        1) die "REFUSING: $OURS does not enumerate the GPU. Not deploying." ;;
        2) die "cannot verify the driver; re-run with --force if you accept the risk" ;;
        esac
    fi

    if is_ours; then
        say "already deployed; refreshing the stamp only"
    else
        # $SYS is currently the distro driver -- take (or refresh) the backup
        # from it. Refreshing matters: after a mesa update the backup must be
        # the NEW distro driver, or 'disable' would roll the system back to an
        # older Mesa than the one installed.
        cp -a "$SYS" "$BACKUP.tmp.$$" || die "could not back up $SYS"
        mv -f "$BACKUP.tmp.$$" "$BACKUP" || die "could not back up $SYS"
        say "backed up the distro driver -> $BACKUP"
        atomic_install "$OURS" "$SYS" || die "could not install $OURS -> $SYS"
        say "deployed: $OURS -> $SYS"
    fi

    mkdir -p "$STAMPDIR"
    date -Iseconds > "$STAMP"

    say
    say "Now do the two per-user steps, as your normal user, not root:"
    say "    $PROG user-config"
    say
    say "Revert with: $PROG disable"
}

# Called from the RPM file trigger after anything reinstalls the distro driver.
cmd_reapply() {
    [ -f "$STAMP" ] || exit 0
    [ -f "$OURS" ] || exit 0
    [ -f "$SYS" ] || exit 0
    is_ours && exit 0
    cp -a "$SYS" "$BACKUP.tmp.$$" 2>/dev/null && mv -f "$BACKUP.tmp.$$" "$BACKUP"
    atomic_install "$OURS" "$SYS" || exit 0
    echo "$PROG: mesa was updated; re-applied the patched Honeykrisp driver." >&2
    echo "$PROG: run '$PROG disable' if you did not want that." >&2
}

cmd_disable() {
    need_root
    if [ ! -f "$BACKUP" ]; then
        rm -f "$STAMP"
        die "no backup at $BACKUP -- nothing to restore.
    If the system driver is wrong, reinstall it:  dnf reinstall mesa-vulkan-drivers"
    fi
    atomic_install "$BACKUP" "$SYS" || die "could not restore $SYS"
    rm -f "$STAMP"
    say "restored the distro driver from $BACKUP"
    say "The backup is kept. Remove it with: rm $BACKUP"
}

cmd_user_config() {
    [ "$(id -u)" != 0 ] || err "note: running as root writes /root/.drirc, which is
    almost certainly not what you want. Run this as your normal user."

    local rc="$HOME/.drirc"
    if grep -qs 'driver="hk"' "$rc"; then
        say "$rc already carries hk options; leaving it alone."
    else
        # WHY $HOME/.drirc and not the packaged /usr/share/drirc.d file: the
        # driver searches DATADIR/drirc.d, and inside the pressure-vessel mount
        # namespace the game runs in, the host's /usr/share is not where the
        # driver looks. $HOME is shared through into muvm and pressure-vessel,
        # and $HOME/.drirc is parsed unconditionally. Without this the game
        # reports "Max supported feature level: 11.0" and refuses to start.
        if [ -e "$rc" ]; then
            cp -a "$rc" "$rc.honeykrisp-got.bak" && say "backed up $rc -> $rc.honeykrisp-got.bak"
            say "$rc exists and has no hk section."
            say "Merge the <device driver=\"hk\"> block from $DRIRC_SRC into it by hand;"
            say "two <driconf> roots in one file are not valid."
        else
            install -m 0644 "$DRIRC_SRC" "$rc" && say "installed $rc"
        fi
    fi

    say
    say "Launch Steam like this:"
    say
    say "    ASAHI_LOCAL_MESA=0 steam"
    say
    say "ASAHI_LOCAL_MESA=0 is correct and required. It stops the Fedora Asahi steam"
    say "wrapper pointing VK_DRIVER_FILES at its own build, so everything resolves"
    say "through the system path -- which is now this driver."
    say
    say "For the driver to be reached from an x86-64 game at all, the FEX Vulkan"
    say "thunk must also be enabled. See fex/README.md in got-bringup."
}

cmd_doctor() {
    local bad=0
    check() { # check <label> <ok?> <hint>
        if [ "$2" = 0 ]; then printf '  ok   %s\n' "$1"
        else printf '  FAIL %s\n       %s\n' "$1" "$3"; bad=1; fi
    }
    echo "honeykrisp-got doctor"
    [ "$(uname -m)" = aarch64 ]; check "aarch64" $? "this package is for Apple Silicon under Fedora Asahi Remix"
    [ -e /dev/dri/renderD128 ]; check "/dev/dri present" $? "no render node -- is the asahi DRM driver loaded?"
    [ -f "$OURS" ]; check "packaged driver present" $? "reinstall honeykrisp-got"
    [ -f "$SYS" ]; check "distro driver present" $? "dnf install mesa-vulkan-drivers"
    command -v vulkaninfo >/dev/null; check "vulkan-tools" $? "dnf install vulkan-tools"
    is_ours; check "patched driver deployed" $? "run: $PROG enable"
    grep -qs 'driver="hk"' "$HOME/.drirc"; check "\$HOME/.drirc hk options" $? "run: $PROG user-config"
    [ -f "$HOME/.fex-emu/ThunksDB.json" ] && [ -f "$HOME/.fex-emu/Config.json" ]
    check "FEX Vulkan thunk configured" $? "without it Steam games use an emulated x86-64 Mesa and never reach this driver -- see got-bringup fex/README.md"
    echo
    [ "$bad" = 0 ] && echo "all checks passed" || echo "some checks failed (see above)"
    return "$bad"
}

# ----------------------------------------------------------------------- usage

usage() {
    cat <<EOF
$PROG -- the patched Honeykrisp Vulkan driver from github.com/aquarat/got-bringup

  status         what is deployed right now
  test           run vulkaninfo against the packaged driver, changing nothing
  enable         deploy it as the system driver (needs root; keeps a backup)
  disable        put the distro driver back (needs root)
  user-config    install the hk driconf options into \$HOME/.drirc
  doctor         check everything the game needs

Options: --yes  --quiet  --force

The driver makes Ghost of Tsushima's compute work about 4.1x cheaper on an
M1 Max. It is a development build of Mesa, not a distro package: read
https://github.com/aquarat/got-bringup/blob/main/INSTALL.md before enabling it.
EOF
}

# -------------------------------------------------------------------- dispatch

CMD=""
ARGS=()
for a in "$@"; do
    case "$a" in
    --quiet) QUIET=1 ;;
    --yes|-y) ASSUME_YES=1 ;;
    --force) FORCE=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $a" ;;
    *) [ -z "$CMD" ] && CMD="$a" || ARGS+=("$a") ;;
    esac
done

# need_root re-execs; keep the original words so flags survive it.
ORIG_ARGV_0="${CMD:-status}"
ORIG_ARGV_REST=""
[ "$QUIET" = 1 ] && ORIG_ARGV_REST="$ORIG_ARGV_REST --quiet"
[ "$ASSUME_YES" = 1 ] && ORIG_ARGV_REST="$ORIG_ARGV_REST --yes"
[ "${FORCE:-0}" = 1 ] && ORIG_ARGV_REST="$ORIG_ARGV_REST --force"

case "${CMD:-status}" in
status)      cmd_status ;;
test)        cmd_test ;;
enable)      cmd_enable ;;
disable)     cmd_disable ;;
reapply)     cmd_reapply ;;
user-config) cmd_user_config ;;
doctor)      cmd_doctor ;;
*)           usage; exit 2 ;;
esac
